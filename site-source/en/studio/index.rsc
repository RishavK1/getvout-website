:{\"title\":\"Looked at the very bottom\",\"hint\":\"Carry the magnifier to the end of the page, below where the name comes from.\"},\"brief\":{\"title\":\"Checked the button\",\"hint\":\"On the start-a-project page, hold the magnifier over the send button.\"},\"reel\":{\"title\":\"Looked behind the work\",\"hint\":\"On the work page, hold the magnifier over the first project.\"}},\"loupe\":{\"take\":\"Pick up the magnifier\"},\"chapters\":{\"stance\":\"Stance\",\"packages\":\"Packages\",\"values\":\"Values\",\"path\":\"Path\",\"voices\":\"Voices\",\"story\":\"Stories\",\"lost\":\"Lost\",\"faq\":\"Questions\",\"region\":\"Collaboration\",\"awards\":\"Awards\"},\"hero\":{\"chapter\":\"Intro\",\"headline\":\"Take a closer look.\",\"lead\":\"Design and software studio from Karnal, India. One team, both sides: design and code.\",\"secondary\":{\"label\":\"See the work\",\"href\":\"/work\"},\"invite\":[\"Pick\",\"me up.\"],\"scroll\":\"Scroll down.\",\"scrollWhy\":\"The building starts below.\"},\"secret\":{\"letters\":{\"G\":\"One of five. The rest are hidden on the other pages.\",\"E\":\"Requirements first.\",\"N\":\"N for next step.\",\"A\":\"All real. No mock-ups.\",\"U\":\"All five? Write GENAU in your message.\"},\"titles\":{\"works\":\"Real projects, real numbers.\",\"services\":\"Fixed price. Always.\",\"studio\":\"Our approach. In motion.\",\"journal\":\"Original angles, AI-assisted drafting and linked primary guidance.\",\"contact\":\"A conversation with our team.\",\"start\":\"Three minutes. No more.\",\"legal\":\"This too: precise.\",\"project\":\"With numbers, not adjectives.\",\"post\":\"Reading estimate includes the editorial text; explore the demos at your own pace.\",\"lost\":\"Looked closely here too.\",\"service\":\"One service, one page.\",\"region\":\"This is home.\"},\"pages\":{\"packages\":\"No small print.\",\"price\":\"Clear scope. In writing.\",\"contactMail\":\"A direct line to our team.\",\"portrait\":\"A real project detail, in the original frame.\",\"window\":\"North light. Good for colour.\",\"loud\":\"This is where it gets loud.\",\"eighth\":\"An eighth too early? Everyone hears it.\",\"stack\":\"Not everything. The right things.\",\"road\":\"And on it goes.\",\"brief\":\"These lines become your site.\"},\"proof\":{\"sie\":\"Formal, not chummy.\",\"first\":\"The first letter sets the measure.\",\"word\":\"getvout \\u2192 thoughtful work, made real.\",\"dot\":\"This full stop is the logo.\",\"tracking\":\"Tracking \\u22123.5 %\",\"kerning\":\"Kerning: by hand\"},\"lead\":{\"measure\":\"30 characters. No more.\",\"cut\":\"Different roles. One team.\",\"struck\":\"agency\"},\"buttons\":{\"primary\":\"This is where most people click.\",\"secondary\":\"For those who look first.\"},\"manifest\":{\"claim\":\"Not one sentence too many.\",\"rule\":\"20 px of air above each principle.\"},\"services\":{\"fan\":\"The fan gives way where you point.\",\"price\":\"Clear scope. In writing.\"},\"work\":{\"stack\":\"Each card 20 px lower than the last.\",\"honest\":\"Real work by our team.\",\"live\":\"No mockup. The site is really live.\"},\"journal\":{\"short\":\"Short. Concrete. No buzzwords.\"},\"cta\":{\"circle\":\"This is where it starts.\",\"margin\":\"1 conversation, 0 obligation.\"},\"footer\":{\"origin\":\"One team. A close eye on every detail.\"}},\"build\":{\"label\":\"The build\",\"progress\":\"Build progress\",\"skip\":\"Skip the build\",\"mockNav\":[\"Work\",\"Services\",\"Studio\"],\"mockMenu\":\"Menu\",\"secondary\":\"See the work\",\"swatches\":{\"ink\":\"Ink\",\"paper\":\"Paper\",\"dot\":\"Dot\"},\"chips\":[\"Fast\",\"100 / 100\",\"AA\"],\"file\":\"Button.tsx\",\"button\":\"Button\",\"click\":\"Go on, try it.\"},\"sketch\":{\"brand\":\"Brand\",\"price\":\"Pay\",\"uptime\":\"Online\",\"always\":\"24/7\",\"likes\":\"+128\"},\"services\":{\"heroTitle\":\"Everything your business needs online.\",\"heroLead\":\"From the mark to the server. You work directly with our design and development team.\",\"price\":\"Next step\",\"duration\":\"Duration\",\"ask\":\"Enquire\",\"get\":\"What you get\",\"how\":\"How it works\",\"packagesTitle\":\"A starting point. Shaped around you.\",\"packagesLead\":\"Start with the right foundations. We shape the scope around your goals, requirements and priorities.\",\"ctaTitle\":\"Not sure what you need?\",\"ctaText\":\"A first conversation to understand your requirements. Then we discuss the scope, timeline and a tailored quote.\",\"more\":\"Take a closer look\",\"vat\":\"We talk first. Your requirements shape the scope, suggested timeline and proposal \\u2014 no one-size-fits-all pricing.\",\"soon\":\"Practical AI\",\"soonShort\":\"Planning\",\"soonAsk\":\"Enquire now\",\"status\":\"Status\",\"soonSheet\":{\"label\":\"Status\",\"scale\":\"Planning\",\"steps\":[\"Discovery\",\"Test together\",\"Roll out\"],\"title\":\"Built around your business.\",\"text\":\"We define a useful first use case, test it with your team and agree the safeguards before a controlled rollout. The scope and timeline depend on your requirements.\"},\"modules\":{\"label\":\"Building blocks\",\"title\":\"Modules.\",\"lead\":\"Building blocks that let your website do more than look good. Pick the modules you need, now or later. We discuss the requirements before including them in your proposal.\",\"add\":\"Add\",\"added\":\"Added\",\"count\":e=>1===e?\"module added\":\"modules added\",\"empty\":\"Tap \\u201cAdd\\u201d to take modules with you.\",\"cta\":\"Enquire with this selection\",\"plain\":\"Enquire about a website\",\"reset\":\"Clear\",\"message\":e=>`I am interested in a website with these modules: ${e}.`,\"items\":[{\"id\":\"booking\",\"title\":\"Online booking\",\"text\":\"Customers book themselves, around the clock, straight into your calendar. Confirmation and reminder go out on their own.\",\"scene\":{\"a\":\"Tue 2:30 pm\"}},{\"id\":\"cms\",\"title\":\"Content management\",\"text\":\"Update text, images, product information and opening hours in your browser. We set up the agreed fields and show your team how to manage them.\",\"scene\":{\"a\":\"Mon\\u2013Fri 8\\u20135\",\"b\":\"Save\"}},{\"id\":\"automation\",\"title\":\"Automations\",\"text\":\"An enquiry comes in, the rest runs by itself: a reply to the customer, an entry in the calendar, a quote as a PDF, a note to you.\",\"scene\":{\"a\":\"PDF\"}},{\"id\":\"payment\",\"title\":\"Online payment\",\"text\":\"Deposits, gift vouchers, course fees: paid by card, Apple Pay or Google Pay, straight into your account.\",\"scene\":{\"a\":\"Paid\"}},{\"id\":\"languages\",\"title\":\"Multilingual\",\"text\":\"German, English, every language your customers speak. With its own address per language, so Google finds all of them.\",\"scene\":{\"a\":\"Willkommen\",\"b\":\"Welcome\",\"c\":\"Benvenuti\"}},{\"id\":\"reviews\",\"title\":\"Google reviews\",\"text\":\"Your real reviews on your own site, always up to date. Trust before anyone picks up the phone.\",\"scene\":{\"a\":\"4.9\"}},{\"id\":\"newsletter\",\"title\":\"Newsletter\",\"text\":\"Collect addresses, send news. With a confirmation email, as the law requires.\",\"scene\":{\"a\":\"name@business.com\"}},{\"id\":\"analytics\",\"title\":\"Cookie-free analytics\",\"text\":\"See what gets read and where visitors come from. No cookie banner, no data sent to Google.\",\"scene\":{\"a\":\"0 cookies\"}},{\"id\":\"chat\",\"title\":\"AI chat\",\"text\":\"Answers questions about prices, opening hours and offers, even at eleven at night. Knows only what is on your site.\",\"scene\":{\"a\":\"Open Saturday?\",\"b\":\"Yes, 9 to 12.\"},\"soon\":true}]},\"assistants\":{\"label\":\"Three assistants\",\"title\":\"Phone, inbox, chat.\",\"lead\":\"On their own or together, set up for your business and with your rules.\",\"items\":[{\"id\":\"phone\",\"title\":\"On the phone\",\"text\":\"Takes calls while you are with a customer, answers simple questions, books appointments and notes call-backs.\",\"scene\":{\"a\":\"Call back 4 pm\"}},{\"id\":\"mail\",\"title\":\"In the inbox\",\"text\":\"Sorts what comes in and prepares replies. You read them over and press send.\",\"scene\":{\"a\":\"Draft\"}},{\"id\":\"chat\",\"title\":\"On the website\",\"text\":\"A chat that knows your prices, hours and offers, and hands over as soon as it gets tricky.\",\"scene\":{\"a\":\"Open Saturday?\",\"b\":\"Yes, 9 to 12.\"}}]},\"detail\":{\"back\":\"All services\",\"fixed\":\"Proposal\",\"fixedValue\":\"After discovery\",\"where\":\"Collaboration\",\"whereValue\":\"Karnal & online\",\"about\":\"What it is about.\",\"faqTitle\":\"Frequent questions.\",\"faqLead\":\"What people often ask before the first meeting. Anything else, ask our team directly.\",\"workTitle\":\"Related work.\",\"next\":\"Next service\",\"localTitle\":\"Based in Karnal. Working together.\",\"localText\":\"getvout is a team based in Karnal, Haryana, India. We work closely with you through discovery, design, development and launch. Meetings and collaboration are planned around your location and requirements.\",\"localLink\":\"Talk to our team\",\"ask\":\"Enquire about this\"}},\"region\":{\"title\":\"Digital agency in the Haryana.\",\"lead\":\"Based in Karnal, Haryana, India. We collaborate with businesses remotely.\",\"mapTitle\":\"Just around the corner.\",\"mapLead\":\"Six neighbouring municipalities, two federal states, one studio in the middle. If your business is here, you do not have far to go to me, and I do not have far to go to you.\",\"mapX\":\"Map\",\"coords\":\"48.360\\u00b0 N \\u00b7 14.897\\u00b0 E\",\"stateOO\":\"Haryana, India\",\"stateNO\":\"Based in Karnal, Haryana, India. We collaborate with businesses remotely.\",\"neighbour\":\"Neighbour\",\"mapNote\":\"As the crow flies from Karnal, town centres from OpenStreetMap.\",\"whyTitle\":\"What being neighbours means.\",\"why\":[{\"title\":\"At the same table.\",\"text\":\"We have the first meeting at your business, free of charge. Photos are taken on site, not picked from a stock library.\"},{\"title\":\"One team, a direct line.\",\"text\":\"You talk to the person who designs and builds. No hotline, no forwarding, no ticket.\"},{\"title\":\"From here, for here.\",\"text\":\"Based in Karnal, Haryana, India. We collaborate with businesses remotely.\"}],\"workTitle\":\"From the neighbourhood.\",\"workLead\":\"Projects for businesses and clubs from the region, as they are online today.\",\"servicesTitle\":\"What I do here.\",\"faqTitle\":\"Asked and answered.\",\"faq\":[{\"q\":\"Do you only work for businesses in the Haryana?\",\"a\":\"Based in Karnal, Haryana, India. We collaborate with businesses remotely.\"},{\"q\":\"Do you come to our business?\",\"a\":\"Based in Karnal, Haryana, India. We collaborate with businesses remotely.\"},{\"q\":\"How much does a website cost at a local digital agency?\",\"a\":\"At getvout.: {prices}. After the first meeting you get a fixed price in writing.\"},{\"q\":\"Web agency, digital agency or web designer?\",\"a\":\"For you it is the same thing: getvout. designs and builds your website or online shop, creates logo and photos and looks after hosting. Whether you are looking for a web agency in Karnal, a digital agency in the Haryana or someone to build your website: you end up with the same person.\"},{\"q\":\"Why an agency nearby?\",\"a\":\"Short distances, a face you know and someone who understands the region and its customers. And when something comes up, your contact is not in another country.\"}],\"ctaTitle\":\"Over a coffee?\",\"ctaText\":\"Tell me about your project, at your business or online. The first meeting costs nothing.\"},\"home\":{\"servicesTitle\":\"Everything your business needs online. From one team.\",\"worksTitle\":\"Selected work.\",\"journalTitle\":\"From the journal.\",\"ctaTitle\":\"Tell us about your project.\",\"allWorks\":\"All work\",\"caseStudy\":\"Visit project\",\"allPosts\":\"All articles\"},\"works\":{\"title\":\"Work.\",\"lead\":\"Websites, products and digital experiences by our team. Real 