a:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"AboutPage\",\"name\":\"The getvout team\",\"url\":\"https://getvout.com/studio\",\"about\":{\"@type\":\"Organization\",\"name\":\"getvout\"}}"}}],"$L15",["$","section",null,{"className":"shell frame grid gap-10 md:grid-cols-12 md:gap-16","children":[["$","$L1d",null,{"className":"md:col-span-5","children":["$","$L1e",null,{"label":"Work detail","data-note":"A real project detail in the original parallax image frame.","children":["$","$L1f",null,{"label":"Work detail · 3:4","children":["$","div",null,{"className":"relative aspect-[3/4] overflow-hidden rounded-[var(--radius-media)] border border-line bg-paper-2","children":[["$","$L20",null,{"src":"/api/media/file/getvout-jac-creation.jpg","alt":"JAC Creation — a detail from our project work, not a team portrait.","fill":true,"sizes":"(min-width: 768px) 40vw, 100vw","priority":true,"className":"object-cover parallax-img","style":{"objectPosition":"50% 50%"}}],null]}]}]}]}],["$","$L21",null,{"index":1,"className":"md:col-span-7 md:pt-4","children":[["$","div",null,{"className":"prose","children":[["$","p","0",{"children":[["$","$1","0",{"children":"A useful digital experience starts with the business behind it: what you do, who you serve and what people need to accomplish. We ask those questions before deciding what to build."}]]}],["$","p","1",{"children":[["$","$1","0",{"children":"We work as a team across design and development. Ideas are reviewed together, so the visual direction stays connected to the way the product actually works. You have a direct conversation with the people shaping the work."}]]}],["$","p","2",{"children":[["$","$1","0",{"children":"The details matter beyond the first impression: mobile layouts, clear content, considered interactions and a practical handover. We discuss the requirements first, agree the scope and keep the work focused on what is useful."}]]