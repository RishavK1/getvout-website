7:["$","html",null,{"lang":"en","className":"Yhr4hG_variable UytG7G_variable KxHFRW_variable kC8RFq_variable","suppressHydrationWarning":true,"children":[["$","head",null,{"children":[["$","script",null,{"id":"theme-init","dangerouslySetInnerHTML":{"__html":"// Canonical English getvout content; no source-brand replacement tables.\n(() => {\nconst studio={\"locale\":\"en-IN\",\"meta\":{\"title\":\"getvout \\u2014 Websites, software & digital studio\",\"description\":\"getvout is a team in Karnal, Haryana, India building websites, online shops, software and digital experiences.\",\"ogLocale\":\"en_IN\",\"works\":{\"title\":\"getvout Work \\u2014 Websites, products & digital experiences\",\"description\":\"Explore eight selected getvout projects across websites and digital products.\"},\"services\":{\"title\":\"getvout Services \\u2014 Websites, software & digital experiences\",\"description\":\"Websites, online shops, custom software, brand & logo, workflow automation, hosting, domains and email. Built by our team, scoped around your requirements.\"},\"studio\":{\"title\":\"Studio \\u2014 Meet the getvout team\",\"description\":\"Meet our digital studio in Karnal, Haryana, India. Strategy, design and development from one collaborative team.\"},\"journal\":{\"title\":\"Journal: design, code & craft\",\"description\":\"Practical notes on useful websites: interfaces, performance, accessibility and search. Clear explanations, live examples and linked sources.\"},\"contact\":{\"title\":\"Contact getvout \\u2014 Let\\u2019s talk\",\"description\":\"Talk with our team about your project. Email hello@getvout.com or message us on WhatsApp at +91 7404511743.\"},\"start\":{\"title\":\"Start a project with getvout\",\"description\":\"Share your project goals, requirements and suggested timing with the getvout team. We discuss the scope before preparing a tailored proposal.\"},\"imprint\":\"Imprint\",\"privacy\":\"Privacy\",\"projectMissing\":\"Project not found\",\"postMissing\":\"Article not found\",\"serviceMissing\":\"Service not found\",\"region\":{\"title\":\"Digital studio in Karnal, Haryana, India\",\"description\":\"Websites, software and digital experiences by the getvout team in Karnal, Haryana, India.\"}},\"common\":{\"skip\":\"Skip to content\",\"homeAria\":\"getvout home\",\"breadcrumb\":\"Breadcrumb\"},\"nav\":{\"items\":[{\"label\":\"Work\",\"href\":\"/work\",\"description\":\"Projects and case studies\"},{\"label\":\"Services\",\"href\":\"/services\",\"description\":\"Offer and packages\"},{\"label\":\"Studio\",\"href\":\"/studio\",\"description\":\"The team behind it\"},{\"label\":\"Journal\",\"href\":\"/journal\",\"description\":\"Thoughts and insights\"},{\"label\":\"Contact\",\"href\":\"/contact\",\"description\":\"Say hello\"}],\"cta\":{\"label\":\"Start a project\",\"href\":\"/start-project\"},\"legal\":[{\"label\":\"Imprint\",\"href\":\"/imprint\"},{\"label\":\"Privacy\",\"href\":\"/privacy\"}],\"start\":\"Home\",\"counts\":{\"project\":\"project\",\"projects\":\"projects\",\"services\":\"services\",\"post\":\"article\",\"posts\":\"articles\"},\"previewAlt\":{\"studio\":\"Workbench\",\"contact\":\"Magnifier\"}},\"header\":{\"xray\":\"X-ray\",\"xrayOn\":\"Turn on X-ray view\",\"xrayOff\":\"Turn off X-ray view\",\"xrayTitle\":\"X-ray: show how the page is built\",\"soundOn\":\"Turn sound on\",\"soundOff\":\"Turn sound off\",\"soundIsOn\":\"Sound is on\",\"soundIsOff\":\"Sound is off\",\"menu\":\"Menu\",\"close\":\"Close\",\"lang\":\"Language\",\"langTitle\":\"Auf Deutsch wechseln\"},\"menu\":{\"aria\":\"Main menu\",\"chapters\":\"Chapters\",\"scheme\":\"Colour scheme\",\"light\":\"Light\",\"dark\":\"Dark\",\"place\":\"Karnal, Haryana, India\"},\"footer\":{\"tagline\":\"Web and digital studio from Karnal, Haryana, India. Strategy, design and code by one team.\",\"origin\":\"getvout. Thoughtful work, made real.\",\"chapters\":\"Chapters\",\"contact\":\"Contact\",\"region\":\"Karnal & beyond\",\"awards\":\"Our focus\",\"a