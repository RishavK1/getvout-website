ournal\":{\"title\":\"Journal: design, code & craft\",\"description\":\"Practical notes on useful websites: interfaces, performance, accessibility and search. Clear explanations, live examples and linked sources.\"},\"contact\":{\"title\":\"Contact getvout \\u2014 Let\\u2019s talk\",\"description\":\"Talk with our team about your project. Email hello@getvout.com or message us on WhatsApp at +91 7404511743.\"},\"start\":{\"title\":\"Start a project with getvout\",\"description\":\"Share your project goals, requirements and suggested timing with the getvout team. We discuss the scope before preparing a tailored proposal.\"},\"imprint\":\"Imprint\",\"privacy\":\"Privacy\",\"projectMissing\":\"Project not found\",\"postMissing\":\"Article not found\",\"serviceMissing\":\"Service not found\",\"region\":{\"title\":\"Digital studio in Karnal, Haryana, India\",\"description\":\"Websites, software and digital experiences by the getvout team in Karnal, Haryana, India.\"}},\"common\":{\"skip\":\"Skip to content\",\"homeAria\":\"getvout home\",\"breadcrumb\":\"Breadcrumb\"},\"nav\":{\"items\":[{\"label\":\"Work\",\"href\":\"/work\",\"description\":\"Projects and case studies\"},{\"label\":\"Services\",\"href\":\"/services\",\"description\":\"Offer and packages\"},{\"label\":\"Studio\",\"href\":\"/studio\",\"description\":\"The team behind it\"},{\"label\":\"Journal\",\"href\":\"/journal\",\"description\":\"Thoughts and insights\"},{\"label\":\"Contact\",\"href\":\"/contact\",\"description\":\"Say hello\"}],\"cta\":{\"label\":\"Start a project\",\"href\":\"/start-project\"},\"legal\":[{\"label\":\"Imprint\",\"href\":\"/imprint\"},{\"label\":\"Privacy\",\"href\":\"/privacy\"}],\"start\":\"Home\",\"counts\":{\"project\":\"project\",\"projects\":\"projects\",\"services\":\"services\",\"post\":\"article\",\"posts\":\"articles\"},\"previewAlt\":{\"studio\":\"Workbench\",\"contact\":\"Magnifier\"}},\"header\":{\"xray\":\"X-ray\",\"xrayOn\":\"Turn on X-ray view\",\"xrayOff\":\"Turn off