{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build-vercel.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "{site-source/**,journal-content/articles.json,serve.py,enquiries.py}",
      "maxDuration": 30
    }
  },
  "routes": [
    {"src": "/(?:en(?:/.*)?|contact|start-project|)", "dest": "/api/index"},
    {"handle": "filesystem"},
    {"src": "/(.*)", "dest": "/api/index"}
  ]
}
